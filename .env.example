VITE_AHA_TRACK_ENDPOINT=https://ahadigitalmarketingpage.onrender.com/api/track/event

# Set this only if digital_marketing-master has TRACK_API_KEY configured.
# Never commit a real tracking key.
VITE_AHA_TRACK_KEY=

# Streamlit uses these equivalents when running app.py locally or on Streamlit.
AHA_TRACK_ENDPOINT=https://ahadigitalmarketingpage.onrender.com/api/track/event
AHA_TRACK_KEY=

# Existing lead-sync endpoint used by components/lead_capture.py.
AHA_DASHBOARD_API_URL=http://127.0.0.1:3200
AHA_DASHBOARD_LEAD_KEY=

# Cloudflare Pages Functions payment secrets. Add both as encrypted secrets
# in Workers & Pages > aha-nexcruise > Settings > Variables and Secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional server-side override. The Cloudflare compatibility functions use
# this NCV2 endpoint by default and never expose it as a browser dependency.
NCV2_API_BASE_URL=https://ncv2.ahacaros.com/api/vehicle
